{
  "name": "@maha-grid/farcaster-mini-app",
  "version": "1.0.0",
  "description": "Maha Grid — Governança Agêntica, Jogo Phygital (9 Ciclos), Farcaster Mini App (Frame v2), Simulação cadCAD/TokenSpice & Kit de Grants Públicos",
  "private": false,
  "license": "MIT",
  "scripts": {
    "dev": "npx serve . -l 3000",
    "simulate": "python3 simulations/maha_grid_sim.py",
    "simulate:network": "python3 simulations/surfpool_network_sim.py",
    "embassy": "python3 src/embassy_agent_engine.py",
    "neynar:scribe": "node src/neynar_scribe_client.mjs",
    "azer:brain": "node src/azer_neynar_v2_brain.mjs",
    "api:quad": "node src/azer_quad_api_adapter.mjs",
    "build:apk": "python3 scripts/build_apk.py",
    "test:e2e": "node tests/e2e_playwright_quad_api.spec.mjs",
    "test": "python3 -m unittest discover -s simulations -p 'test_*.py'",
    "neynar:init": "npx @neynar/create-farcaster-mini-app@latest"
  },
  "keywords": [
    "maha-grid",
    "farcaster",
    "frames-v2",
    "mini-apps",
    "neynar",
    "web3-summit",
    "nodespace",
    "polkadot",
    "web3-foundation",
    "nouns-dao",
    "flows",
    "clanker",
    "cadcad",
    "tokenspice",
    "soulbound-token",
    "agentic-governance",
    "phygital"
  ],
  "dependencies": {
    "@farcaster/frame-sdk": "^0.0.30",
    "@neynar/nodejs-sdk": "^3.177.0"
  }
}
